{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "temper build args",
  "description": "Reference schema for the args passed to the build workflow (stage 3). The workflow's validateBuildArgs is the enforcing check; it also refuses two tasks in one wave owning the same path, a task using a contract no earlier wave provides, an answer for an unknown task, and an ssh host clone inside <root>/<epic>/.",
  "type": "object",
  "required": ["epic", "repo", "branch", "base", "spec", "plan", "log", "host", "gates", "tasks", "behaviour_groups", "done", "answers"],
  "properties": {
    "epic": { "type": "string", "pattern": "^[a-z0-9][a-z0-9:-]*$" },
    "repo": { "type": "string" },
    "branch": { "type": "string" },
    "base": { "type": "string" },
    "default_branch": { "type": "string", "minLength": 1, "description": "The repo's default branch (origin/HEAD without its remote). The workflows refuse a branch that names it or the base, however either is spelled: refs/heads/, heads/, refs/remotes/<remote>/, remotes/<remote>/, origin/ and upstream/ are stripped and case is folded." },
    "spec": { "type": "string" },
    "plan": { "type": "string" },
    "log": { "type": "string" },
    "build_rule": { "type": "string", "description": "Optional. The project's build rule (project.md's ## Build rule), passed to every agent as data." },
    "flaky": { "type": "array", "items": { "type": "string" }, "description": "Optional. Known flaky tests (project.md's flaky:), which a quick gate may rerun once." },
    "host": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "local" } }
        },
        {
          "type": "object",
          "required": ["kind", "name", "root", "clone"],
          "properties": {
            "kind": { "const": "ssh" },
            "name": { "type": "string", "minLength": 1 },
            "root": { "type": "string", "minLength": 1 },
            "clone": { "type": "string", "pattern": "^(/|~/)", "description": "The repo's clone on the host (project.md's host_clone), outside <root>/<epic>/. The head fetches the epic and task branches back from ssh://<name>/<clone> (amendment A7)." }
          }
        }
      ]
    },
    "gates": {
      "type": "object",
      "required": ["quick", "full"],
      "properties": {
        "quick": { "type": "string", "minLength": 1 },
        "full": { "type": "string", "minLength": 1 }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/task" }
    },
    "behaviour_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "title"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9:-]*$" },
          "title": { "type": "string" }
        }
      }
    },
    "done": {
      "type": "array",
      "items": { "type": "string" }
    },
    "answers": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "behaviour": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "behaviours"],
        "properties": {
          "key": { "type": "string" },
          "behaviours": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "text"],
              "properties": {
                "id": { "type": "string" },
                "text": { "type": "string" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "required": ["id", "title", "wave", "owns", "uses", "provides", "text"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9:-]*$" },
        "title": { "type": "string" },
        "wave": { "type": "integer", "minimum": 0 },
        "owns": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "uses": {
          "type": "array",
          "items": { "type": "string" }
        },
        "provides": {
          "type": "array",
          "items": { "type": "string" }
        },
        "text": { "type": "string", "minLength": 1 }
      }
    }
  }
}
